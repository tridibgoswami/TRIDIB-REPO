# ─── AngelOne SmartAPI Credentials ───────────────────────────────────────────
ANGELONE_API_KEY=your_api_key_here
ANGELONE_CLIENT_ID=your_client_id_here
ANGELONE_PASSWORD=your_mpin_here
ANGELONE_TOTP_SECRET=your_totp_secret_here       # Base32 secret from AngelOne app QR code

# ─── Telegram Bot ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here            # From @BotFather
TELEGRAM_CHAT_ID=your_chat_id_here                # Your personal or group chat ID

# ─── Webhook Security ─────────────────────────────────────────────────────────
WEBHOOK_SECRET=your_strong_secret_here            # Include this in every TradingView alert

# ─── Server Config ────────────────────────────────────────────────────────────
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000

# ─── Risk Management ──────────────────────────────────────────────────────────
MAX_DAILY_LOSS=5000                               # Max loss in INR before bot halts for the day
MAX_OPEN_POSITIONS=2                              # Max simultaneous open positions
DEFAULT_QUANTITY=25                               # Default lot quantity (1 lot Nifty = 25, BankNifty = 15)
SQUARE_OFF_TIME=15:15                             # Auto square-off time (IST), 15 min before close
