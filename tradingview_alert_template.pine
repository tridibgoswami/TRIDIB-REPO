// ─────────────────────────────────────────────────────────────────────────────
// SAMPLE PINE SCRIPT INTEGRATION
// Add this to your existing indicator to send alerts:
// ─────────────────────────────────────────────────────────────────────────────

//@version=5
indicator("My Signal Indicator", overlay=true)

// ... your existing signal logic ...

// Example: when your buy signal fires, use alertcondition():
// alertcondition(buySignal, title="BUY Signal", message='{"secret":"YOUR_SECRET","symbol":"NIFTY","action":"BUY","instrument":"FUT","expiry":"29MAY2025","strike":0,"price":0,"quantity":25,"product_type":"INTRADAY","order_type":"MARKET"}')
// alertcondition(sellSignal, title="SELL Signal", message='{"secret":"YOUR_SECRET","symbol":"NIFTY","action":"SELL","instrument":"FUT","expiry":"29MAY2025","strike":0,"price":0,"quantity":25,"product_type":"INTRADAY","order_type":"MARKET"}')
